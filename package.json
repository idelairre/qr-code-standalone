{
   "name": "qr-code-standalone",
   "version": "1.0.0",
   "description": "Standalone QR Code Generator with vCard support",
   "keywords": [
      "chakra-ui",
      "qr-code",
      "react",
      "vcard",
      "vite"
   ],
   "homepage": "https://idelairre.github.io/qr-code-standalone",
   "license": "MIT",
   "author": "Ian Delairre",
   "type": "module",
   "main": "dist/index.js",
   "scripts": {
      "dev": "vite",
      "build": "vite build",
      "preview": "vite preview",
      "lint:ox": "oxlint --react-plugin .",
      "lint:ox:fix": "oxlint --react-plugin --fix .",
      "format": "oxfmt .",
      "format:check": "oxfmt --check .",
      "predeploy": "bun run build && node scripts/copy-404.js",
      "deploy": "node scripts/gh-pages-publish.js",
      "setup-github-pages": "node scripts/setup-github-pages.js",
      "deploy-full": "node scripts/deploy.js",
      "run-all": "node scripts/run-all.js",
      "runner": "node scripts/runner.js"
   },
   "dependencies": {
      "@chakra-ui/react": "^3.34.0",
      "@emotion/react": "^11.14.0",
      "@types/potrace": "^2.1.5",
      "framer-motion": "^12.23.3",
      "potrace": "^2.1.8",
      "qr-code-styling": "^1.9.2",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "react-icons": "^5.5.0"
   },
   "devDependencies": {
      "@eslint/js": "^9.15.0",
      "@types/react": "^19.1.2",
      "@types/react-dom": "^19.1.2",
      "@vitejs/plugin-react": "^4.2.1",
      "eslint": "^9.15.0",
      "eslint-plugin-react-hooks": "^5.0.0",
      "eslint-plugin-react-refresh": "^0.4.14",
      "gh-pages": "^6.3.0",
      "globals": "^15.12.0",
      "oxfmt": "^0.42.0",
      "oxlint": "^1.57.0",
      "typescript": "^5.6.3",
      "typescript-eslint": "^8.15.0",
      "vite": "^5.2.0"
   },
   "packageManager": "bun@1.3.5"
}
